{
  "name": "reel-to-trip",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "dev:web": "pnpm --filter @rtt/web dev",
    "dev:api": "pnpm --filter @rtt/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "emulators": "firebase emulators:start --only auth,firestore,storage",
    "genkit:ui": "pnpm --filter @rtt/api genkit:ui"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
