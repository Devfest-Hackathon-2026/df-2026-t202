# Copy to api/.env for local dev. Never commit .env. On Cloud Run, keys come from Secret Manager.
ENV=development

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-northeast1
# Exact Vertex AI model IDs from Model Garden (no "-latest" aliases)
GEMINI_MODEL_FAST=
GEMINI_MODEL_PLANNER=

# Server keys (Places API (New), Routes API, YouTube Data API v3). Restricted by API.
PLACES_API_KEY=
ROUTES_API_KEY=
YOUTUBE_API_KEY=

# Comma-separated web origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:4200
# Local dev only: skip App Check. Must be true in production.
REQUIRE_APP_CHECK=false

# Firebase emulators (pnpm/npm not needed: `firebase emulators:start` from the repo root)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
