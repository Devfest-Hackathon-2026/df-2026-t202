# Copy to web/.env for local dev. Never commit it. Everything here is visible in the browser.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Maps JavaScript API key: restricted by HTTP referrer + API (PLAN.md 11.2)
MAPS_BROWSER_KEY=
API_BASE_URL=http://localhost:8080
# reCAPTCHA Enterprise site key for App Check (empty = App Check off locally)
RECAPTCHA_SITE_KEY=
# true = use the local Firebase emulators (Auth :9099, Firestore :8081)
USE_EMULATORS=true
