# Copy to web/.env.local for local dev. Never commit it. Everything here is visible in the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Maps JavaScript API key: restricted by HTTP referrer + API (PLAN.md 11.2)
NEXT_PUBLIC_MAPS_BROWSER_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# reCAPTCHA Enterprise site key for App Check (empty = App Check off locally)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# true = use the local Firebase emulators (Auth :9099, Firestore :8081)
NEXT_PUBLIC_USE_EMULATORS=true
