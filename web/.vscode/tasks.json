{
  // For more information, visit: https://go.microsoft.com/fwlink/?LinkId=733558
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": { "regexp": "Compiling|Starting" },
          "endsPattern": { "regexp": "Ready in|Compiled" }
        }
      }
    },
    {
      "type": "npm",
      "script": "test",
      "problemMatcher": ["$tsc"]
    }
  ]
}
