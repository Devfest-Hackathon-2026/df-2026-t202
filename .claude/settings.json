{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm build)",
      "Bash(pnpm install)",
      "Bash(pnpm --filter @rtt/web typecheck)",
      "Bash(pnpm --filter @rtt/web build)",
      "Bash(pnpm --filter @rtt/api typecheck)",
      "Bash(pnpm --filter @rtt/api test)",
      "Bash(pnpm --filter @rtt/api build)",
      "Bash(pnpm --filter @rtt/shared typecheck)",
      "Bash(pnpm --filter @rtt/shared test)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/service-account*.json)",
      "Read(**/credentials*.json)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git commit --no-verify:*)"
    ]
  }
}
