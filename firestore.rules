rules_version = '2';

// PLAN.md 11.1. Clients only READ trips; every trip write goes through the API (Admin SDK bypasses rules).
//
// "My trips" query must match the read rule, e.g.:
//   query(collection(db, 'trips'), where(`members.${uid}`, 'in', ['owner', 'viewer']))
// (sort by updatedAt on the client; a composite index on a per-user map key is not possible).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(trip) {
      return signedIn() && trip.data.members[request.auth.uid] in ['owner', 'viewer'];
    }
    function tripDoc(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId));
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'language', 'createdAt'])
        && (!('language' in request.resource.data) || request.resource.data.language in ['en', 'ja']);
      allow delete: if false;
    }

    match /trips/{tripId} {
      allow read: if isMember(resource);
      allow write: if false;

      match /messages/{msgId} {
        allow read: if isMember(tripDoc(tripId));
        allow write: if false;
      }
      match /plans/{planId} {
        allow read: if isMember(tripDoc(tripId));
        allow write: if false;
      }
    }

    // Share links: any signed-in user (anonymous included) can read an active share.
    // Opening a share adds the viewer to trips.members as "viewer" through the API (PLAN.md 11.1, option 1).
    match /shares/{shareId} {
      allow get: if signedIn() && resource.data.active == true;
      allow list, write: if false;
    }

    // Server caches: no client access.
    match /cache_places/{id} { allow read, write: if false; }
    match /cache_videos/{id} { allow read, write: if false; }

    // Abuse-limit counters (PLAN.md 9.6): server only.
    match /users/{uid}/limits/{day} { allow read, write: if false; }
    match /usage/{day} { allow read, write: if false; }
  }
}
