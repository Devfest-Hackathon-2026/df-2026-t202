{
  "name": "@rtt/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "genkit:ui": "npx -y genkit-cli start -- tsx --env-file-if-exists=.env src/index.ts"
  },
  "dependencies": {
    "@genkit-ai/google-genai": "^1.44.0",
    "@hono/node-server": "^2.1.6",
    "@rtt/shared": "workspace:*",
    "firebase-admin": "^14.5.0",
    "genkit": "^1.44.0",
    "hono": "^4.13.17",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  }
}
