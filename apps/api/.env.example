# Copy to .env for local dev. Never commit .env.
# On Cloud Run these come from Secret Manager (see README → Deploy).

PORT=8080
# Comma-separated origins allowed to call the API (the web app)
CORS_ORIGINS=http://localhost:3000

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model ids, configurable so we can switch without a deploy
GEMINI_FLASH_MODEL=gemini-flash-latest
GEMINI_PRO_MODEL=gemini-flash-latest

# Server-side Maps Platform key (Places API (New), Routes API). NOT the browser key.
MAPS_SERVER_API_KEY=

# Firebase project id. Locally with emulators, also set the emulator hosts below.
GOOGLE_CLOUD_PROJECT=demo-rtt
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Set to "true" to skip auth checks locally (never in production)
DEV_SKIP_AUTH=false
# Set to "true" to require Firebase App Check tokens
REQUIRE_APP_CHECK=false

# Per-user limit on reel imports per hour
REEL_IMPORTS_PER_HOUR=20
