# Copy to .env.local for local dev. Never commit it.
# NEXT_PUBLIC_* values end up in the browser — only put browser-safe values here.

# Cloud Run API base URL (local: the api dev server)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Firebase web app config (Firebase console → Project settings → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Browser Maps JavaScript API key — restrict it to your domains + Maps JS API only
NEXT_PUBLIC_MAPS_BROWSER_KEY=

# reCAPTCHA Enterprise site key for Firebase App Check (optional for local dev)
NEXT_PUBLIC_APPCHECK_SITE_KEY=

# "true" = use local Firebase emulators
NEXT_PUBLIC_USE_EMULATORS=false
# "true" = skip sign-in and send x-dev-uid (only works if the API has DEV_SKIP_AUTH=true)
NEXT_PUBLIC_DEV_SKIP_AUTH=false
